<Window x:Class="DigitalTwinIndustrialAutomationPlatform.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DigitalTwinIndustrialAutomationPlatform"
        xmlns:views="clr-namespace:DigitalTwinIndustrialAutomationPlatform.Views"
        xmlns:platform="clr-namespace:DigitalTwinIndustrialAutomationPlatform.Platform"
        Title="{x:Static platform:PlatformInfo.Name}" Icon="/Assets/PlatformIcon.ico" Width="1500" Height="940" MinWidth="1080" MinHeight="720"
        Background="#F3F5F9" Foreground="#243247" FontFamily="Microsoft YaHei UI" FontSize="13"
        Closing="Window_Closing" WindowStyle="None" ResizeMode="CanResize">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="46" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanVisibility" />
        <SolidColorBrush x:Key="Accent" Color="#2563EB" />
        <Style TargetType="Button">
            <Setter Property="Background" Value="White" /><Setter Property="Foreground" Value="#34445D" />
            <Setter Property="BorderBrush" Value="#DCE3EC" /><Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,8" /><Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="MinHeight" Value="36" /><Setter Property="Cursor" Value="Hand" />
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock x:Name="Glyph" Text="{TemplateBinding Tag}" FontFamily="Segoe MDL2 Assets" FontSize="15" Margin="0,0,7,0" VerticalAlignment="Center" />
                                <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="{x:Null}"><Setter TargetName="Glyph" Property="Visibility" Value="Collapsed" /></Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#EEF4FF" /><Setter TargetName="Surface" Property="BorderBrush" Value="#9DB9F5" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="#DFEAFE" /></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#2563EB" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.4" /><Setter Property="Cursor" Value="Arrow" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#2563EB" /><Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#2563EB" /><Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="PrimarySurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="{TemplateBinding Tag}" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <ContentPresenter VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="PrimarySurface" Property="Background" Value="#1D4ED8" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="PrimarySurface" Property="Background" Value="#1E40AF" /></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="PrimarySurface" Property="BorderBrush" Value="#93C5FD" /><Setter TargetName="PrimarySurface" Property="BorderThickness" Value="2" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="PrimarySurface" Property="Opacity" Value="0.4" /><Setter Property="Cursor" Value="Arrow" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Width" Value="48" /><Setter Property="Height" Value="46" />
            <Setter Property="Margin" Value="0" /><Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="White" /><Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CaptionSurface" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CaptionSurface" Property="Background" Value="#334155" /></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="CaptionSurface" Property="Background" Value="#475569" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="10,7" /><Setter Property="BorderBrush" Value="#DCE3EC" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="#243247" /><Setter Property="Background" Value="White" />
        </Style>
        <Style TargetType="MenuItem"><Setter Property="Padding" Value="12,7" /></Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F7F9FC" /><Setter Property="Foreground" Value="#6B7A90" />
            <Setter Property="FontSize" Value="12" /><Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="12,10" /><Setter Property="BorderThickness" Value="0,0,0,1" /><Setter Property="BorderBrush" Value="#E8EDF4" />
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="12,0" /><Setter Property="BorderThickness" Value="0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell">
                <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}"><ContentPresenter VerticalAlignment="Center" /></Border>
            </ControlTemplate></Setter.Value></Setter>
            <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#EAF1FF" /><Setter Property="Foreground" Value="#1D4ED8" /></Trigger></Style.Triggers>
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="ToolTip" Value="{Binding FullPath}" />
            <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#F0F5FF" /></Trigger></Style.Triggers>
        </Style>
        <Style x:Key="ToolGroupLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" /><Setter Property="Foreground" Value="#7B889B" />
            <Setter Property="Margin" Value="0,0,0,7" />
        </Style>
        <Style x:Key="NavigationItem" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#9FB0C8" /><Setter Property="Margin" Value="10,3" />
            <Setter Property="Padding" Value="14,13" /><Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="NavSurface" Background="Transparent" CornerRadius="7" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NavSurface" Property="Background" Value="#23344D" /></Trigger>
                        <Trigger Property="IsChecked" Value="True"><Setter TargetName="NavSurface" Property="Background" Value="#263F64" /><Setter Property="Foreground" Value="White" /></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="NavSurface" Property="BorderBrush" Value="#60A5FA" /><Setter TargetName="NavSurface" Property="BorderThickness" Value="1" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="NavSurface" Property="Opacity" Value="0.45" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
    </Window.Resources>
    <DockPanel>
        <Grid DockPanel.Dock="Top" Height="46" Background="#172338">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,160,0">
                <Image Source="/Assets/PlatformIcon.png" Width="26" Height="26" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="平台图标" />
                <TextBlock Text="{x:Static platform:PlatformInfo.Name}" Foreground="White" FontSize="14" FontWeight="SemiBold" />
                <TextBlock Text="/  模块化工业应用工作台" Foreground="#94A3B8" FontSize="12" Margin="16,2,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource CaptionButton}" Content="—" ToolTip="最小化" WindowChrome.IsHitTestVisibleInChrome="True" Click="Minimize_Click" />
                <Button Style="{StaticResource CaptionButton}" Content="□" ToolTip="最大化 / 还原" WindowChrome.IsHitTestVisibleInChrome="True" Click="Maximize_Click" />
                <Button Style="{StaticResource CaptionButton}" Content="✕" ToolTip="退出" WindowChrome.IsHitTestVisibleInChrome="True" Command="{x:Static local:UiCommands.Exit}" />
            </StackPanel>
        </Grid>
        <Border DockPanel.Dock="Bottom" Background="White" Padding="18,9" BorderBrush="#E1E7F0" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Text="就绪 · 打开图片或文件夹开始检测" FontSize="12" Foreground="#6B7A90" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                <ProgressBar x:Name="BusyIndicator" Grid.Column="1" Width="80" Height="3" IsIndeterminate="True" Visibility="Collapsed" Margin="16,0" />
                <Border Grid.Column="2" Background="#F0F5FF" CornerRadius="10" Padding="9,3" Margin="16,0,0,0">
                    <TextBlock x:Name="ActivityText" Text="待命" Foreground="#2563EB" FontSize="11" />
                </Border>
            </Grid>
        </Border>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="192" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Background="#172338">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="18,24,18,20">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/Assets/PlatformIcon.png" Width="34" Height="34" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="平台图标" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="数字孪生" Foreground="#E2E8F0" FontSize="15" FontWeight="Bold" />
                                <TextBlock Text="工业自动化控制平台" Foreground="#7890AF" FontSize="11" Margin="0,6,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Bottom" Text="统一平台 · 模块应用" Foreground="#6F85A4" FontSize="11" Margin="22,16,0,22" />
                    <StackPanel x:Name="NavigationPanel">
                        <RadioButton x:Name="HomeNavigation" Style="{StaticResource NavigationItem}" GroupName="MainNavigation" Tag="Home" Click="Navigation_Click" AutomationProperties.Name="首页">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="17" Margin="0,0,12,0" VerticalAlignment="Center" /><TextBlock Text="首页" /></StackPanel>
                        </RadioButton>
                        <TextBlock Text="应用模块" Foreground="#6F85A4" FontSize="10" Margin="24,16,0,6" />
                        <ItemsControl x:Name="ModuleNavigation">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type platform:ModuleEntry}">
                                    <RadioButton Style="{StaticResource NavigationItem}" GroupName="MainNavigation" Tag="{Binding Id}"
                                                 IsChecked="{Binding IsSelected, Mode=OneWay}" Click="ModuleNavigation_Click" AutomationProperties.Name="{Binding Name}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Icon}" FontFamily="Segoe MDL2 Assets" FontSize="17" Margin="0,0,12,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Name}" FontSize="12" />
                                        </StackPanel>
                                    </RadioButton>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="平台" Foreground="#6F85A4" FontSize="10" Margin="24,16,0,6" />
                        <RadioButton x:Name="SettingsNavigation" Style="{StaticResource NavigationItem}" GroupName="MainNavigation" Tag="Settings" Click="Navigation_Click" AutomationProperties.Name="设置">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="17" Margin="0,0,12,0" VerticalAlignment="Center" /><TextBlock Text="设置" /></StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="AboutNavigation" Style="{StaticResource NavigationItem}" GroupName="MainNavigation" Tag="About" Click="Navigation_Click" AutomationProperties.Name="关于">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="17" Margin="0,0,12,0" VerticalAlignment="Center" /><TextBlock Text="关于" /></StackPanel>
                        </RadioButton>
                    </StackPanel>
                </DockPanel>
            </Border>
            <Grid x:Name="PageHost" Grid.Column="1">
                <DockPanel x:Name="WorkspacePage" Visibility="Collapsed">
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="#E1E7F0" BorderThickness="0,0,0,1">
            <Menu Background="White" Padding="8,0" FontSize="13">
                <MenuItem Header="文件(_F)">
                    <MenuItem Header="打开图片…" Command="{x:Static local:UiCommands.Open}" />
                    <MenuItem Header="导入文件夹…" Command="{x:Static local:UiCommands.Folder}" />
                    <Separator /><MenuItem Header="保存结果…" Command="{x:Static local:UiCommands.Save}" />
                    <MenuItem Header="导出检测记录…" Command="{x:Static local:UiCommands.Export}" />
                    <Separator /><MenuItem Header="关闭当前图像" Command="{x:Static local:UiCommands.CloseImage}" />
                    <MenuItem Header="退出" Command="{x:Static local:UiCommands.Exit}" />
                </MenuItem>
                <MenuItem Header="视图(_V)">
                    <MenuItem Header="适应窗口" Command="{x:Static local:UiCommands.Fit}" />
                    <MenuItem Header="实际尺寸" Command="{x:Static local:UiCommands.ActualSize}" />
                    <Separator /><MenuItem Header="查找文件" Command="{x:Static local:UiCommands.FocusSearch}" />
                    <MenuItem Header="图像属性…" Command="{x:Static local:UiCommands.Properties}" />
                </MenuItem>
                <MenuItem Header="图像处理(_P)">
                    <MenuItem Header="查看灰度图" Command="{x:Static local:UiCommands.Grayscale}" />
                    <MenuItem Header="运行检测" Command="{x:Static local:UiCommands.Detect}" />
                    <Separator /><MenuItem Header="图像滤波" Command="{x:Static local:UiCommands.Filter}" />
                    <MenuItem Header="边缘检测" Command="{x:Static local:UiCommands.Edges}" />
                    <MenuItem Header="轮廓提取" Command="{x:Static local:UiCommands.Contours}" />
                    <MenuItem Header="形态学操作" Command="{x:Static local:UiCommands.Morphology}" />
                    <MenuItem Header="灰度直方图…" Command="{x:Static local:UiCommands.Histogram}" />
                    <MenuItem Header="模板匹配" Command="{x:Static local:UiCommands.Match}" />
                    <Separator /><MenuItem Header="恢复原图" Command="{x:Static local:UiCommands.Reset}" />
                </MenuItem>
                <MenuItem Header="采集(_C)">
                    <MenuItem Header="连接相机…" Command="{x:Static local:UiCommands.ConnectCamera}" />
                    <MenuItem Header="断开相机" Command="{x:Static local:UiCommands.DisconnectCamera}" />
                    <Separator />
                    <MenuItem Header="开始摄像头预览" Command="{x:Static local:UiCommands.Start}" />
                    <MenuItem Header="停止预览" Command="{x:Static local:UiCommands.Stop}" />
                    <MenuItem Header="采样当前帧" Command="{x:Static local:UiCommands.Sample}" />
                </MenuItem>
                <MenuItem Header="工具(_T)">
                    <MenuItem Header="参数设置">
                        <MenuItem Header="滤波设置…" Command="{x:Static local:UiCommands.FilterSettings}" />
                        <MenuItem Header="边缘设置…" Command="{x:Static local:UiCommands.EdgeSettings}" />
                        <MenuItem Header="轮廓设置…" Command="{x:Static local:UiCommands.ContourSettings}" />
                        <MenuItem Header="形态学设置…" Command="{x:Static local:UiCommands.MorphologySettings}" />
                        <MenuItem Header="模板匹配设置…" Command="{x:Static local:UiCommands.MatchSettings}" />
                    </MenuItem>
                    <MenuItem Header="选择匹配模板…" Command="{x:Static local:UiCommands.TemplateFile}" />
                    <MenuItem Header="检测统计…" Command="{x:Static local:UiCommands.Statistics}" />
                    <Separator /><MenuItem Header="清空文件列表" Command="{x:Static local:UiCommands.ClearFiles}" />
                </MenuItem>
                <MenuItem Header="产品与机器人(_R)">
                    <MenuItem Header="拍照建档" Command="{x:Static local:UiCommands.CaptureProduct}" />
                    <MenuItem Header="从本地图像建档…" Command="{x:Static local:UiCommands.ImportProductImage}" />
                    <MenuItem Header="滤波、轮廓与面积周长测量" Command="{x:Static local:UiCommands.MeasureProduct}" />
                    <MenuItem Header="保存为产品类…" Command="{x:Static local:UiCommands.SaveProduct}" />
                    <MenuItem Header="加载产品类 / 产品库…" Command="{x:Static local:UiCommands.LoadProducts}" />
                    <Separator /><MenuItem Header="连接机器人" Command="{x:Static local:UiCommands.ConnectRobot}" />
                    <MenuItem Header="断开机器人" Command="{x:Static local:UiCommands.DisconnectRobot}" />
                    <MenuItem Header="开始自动识别" Command="{x:Static local:UiCommands.AutoStart}" />
                    <MenuItem Header="停止自动识别" Command="{x:Static local:UiCommands.AutoStop}" />
                </MenuItem>
                <MenuItem Header="帮助(_H)"><MenuItem Header="使用说明…" Command="{x:Static local:UiCommands.Help}" /></MenuItem>
            </Menu>
        </Border>
        <Border DockPanel.Dock="Top" Background="White" Padding="18,12" BorderBrush="#E1E7F0" BorderThickness="0,0,0,1">
            <Grid x:Name="ActionToolbar">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <WrapPanel VerticalAlignment="Center">
                    <StackPanel Margin="0,0,18,0">
                        <TextBlock Text="文件" Style="{StaticResource ToolGroupLabel}" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="打开图片" Tag="&#xE8E5;" Command="{x:Static local:UiCommands.Open}" ToolTip="打开图片 · Ctrl+O" />
                            <Button Content="导入文件夹" Tag="&#xE8B7;" Command="{x:Static local:UiCommands.Folder}" ToolTip="导入文件夹 · Ctrl+Shift+O" />
                            <Button Content="保存结果" Tag="&#xE74E;" Command="{x:Static local:UiCommands.Save}" ToolTip="保存当前显示结果 · Ctrl+S" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="相机采集" Style="{StaticResource ToolGroupLabel}" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="连接相机" Tag="&#xE722;" Command="{x:Static local:UiCommands.ConnectCamera}" ToolTip="搜索电脑相机并选择连接" />
                            <Button x:Name="StartButton" Content="开始预览" Tag="&#xE768;" Command="{x:Static local:UiCommands.Start}" ToolTip="开始摄像头预览 · F5" />
                            <Button x:Name="StopButton" Content="停止" Tag="&#xE71A;" Command="{x:Static local:UiCommands.Stop}" ToolTip="停止并保留最后一帧 · Shift+F5" />
                            <Button Content="采样" Tag="&#xE722;" Command="{x:Static local:UiCommands.Sample}" ToolTip="冻结当前帧并停止预览 · F6" />
                        </StackPanel>
                    </StackPanel>
                </WrapPanel>
                <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Bottom" Orientation="Horizontal">
                    <Button Content="开始自动识别" Tag="&#xE768;" Style="{StaticResource PrimaryButton}" Padding="18,9" Command="{x:Static local:UiCommands.AutoStart}" ToolTip="连接机器人后，按设定频率采样识别并发送产品类型" />
                    <Button Content="设置" Tag="&#xE713;" Command="{x:Static local:UiCommands.Settings}" Margin="2,0,0,0" ToolTip="处理与采集参数" />
                </StackPanel>
            </Grid>
        </Border>
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="#E1E7F0" BorderThickness="0,0,0,1" Padding="16,10">
            <StackPanel>
                <WrapPanel>
                    <TextBlock Text="① 产品建档" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,6" />
                    <Button Content="拍照" Tag="&#xE722;" Command="{x:Static local:UiCommands.CaptureProduct}" Margin="0,0,6,6" />
                    <Button Content="导入本地图像" Tag="&#xE8E5;" Command="{x:Static local:UiCommands.ImportProductImage}" ToolTip="从电脑读取 JPG、PNG、BMP、TIFF 进行产品建档 · Ctrl+Shift+I" Margin="0,0,6,6" />
                    <Button Content="滤波 + 轮廓测量" Tag="&#xE9D9;" Command="{x:Static local:UiCommands.MeasureProduct}" Margin="0,0,6,6" />
                    <Button Content="保存产品类" Tag="&#xE74E;" Command="{x:Static local:UiCommands.SaveProduct}" Margin="0,0,6,6" />
                    <Button Content="加载产品库" Tag="&#xE8B7;" Command="{x:Static local:UiCommands.LoadProducts}" Margin="0,0,6,6" />
                    <TextBlock x:Name="MeasurementText" TextWrapping="Wrap" Text="拍照或导入单个产品图像，再提取面积与周长" Foreground="#617798" VerticalAlignment="Center" Margin="8,0,0,6" />
                </WrapPanel>
                <TextBlock x:Name="CameraStateText" Text="相机未选择" Foreground="#617798" TextWrapping="Wrap" Margin="0,5,0,0" />
                <Expander Header="② 机器人连接与循环识别参数" IsExpanded="True" Margin="0,6,0,0">
                    <StackPanel Margin="0,10,0,0">
                        <WrapPanel>
                            <StackPanel x:Name="RobotEndpointPanel" Orientation="Horizontal" Margin="0,0,12,6">
                                <TextBlock Text="域名/IP" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBox x:Name="RobotHostBox" Width="150" ToolTip="仅域名或 IP，不含 http://" />
                                <TextBlock Text="端口" VerticalAlignment="Center" Margin="10,0,8,0" /><TextBox x:Name="RobotPortBox" Width="72" />
                            </StackPanel>
                            <StackPanel x:Name="RunParameterPanel" Orientation="Horizontal" Margin="0,0,12,6">
                                <TextBlock Text="面积误差 %" VerticalAlignment="Center" Margin="0,0,6,0" /><TextBox x:Name="AreaToleranceBox" Width="55" />
                                <TextBlock Text="周长误差 %" VerticalAlignment="Center" Margin="10,0,6,0" /><TextBox x:Name="PerimeterToleranceBox" Width="55" />
                                <TextBlock Text="采样 Hz" VerticalAlignment="Center" Margin="10,0,6,0" /><TextBox x:Name="SamplingHzBox" Width="55" />
                            </StackPanel>
                            <Button Content="连接机器人" Command="{x:Static local:UiCommands.ConnectRobot}" Margin="0,0,6,6" />
                            <Button Content="断开" Command="{x:Static local:UiCommands.DisconnectRobot}" Margin="0,0,6,6" />
                            <Button Content="停止识别" Tag="&#xE71A;" Command="{x:Static local:UiCommands.AutoStop}" Margin="0,0,6,6" />
                        </WrapPanel>
                        <TextBlock x:Name="RobotStateText" Text="机器人未连接 · TCP / UTF-8 JSON 行报文" Foreground="#617798" TextWrapping="Wrap" />
                        <TextBlock x:Name="AutoStateText" Text="尚未开始 · 面积与周长均满足误差且唯一匹配时发送产品类型" Foreground="#617798" TextWrapping="Wrap" Margin="0,5,0,0" />
                    </StackPanel>
                </Expander>
            </StackPanel>
        </Border>
        <Grid Margin="16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="480" /><ColumnDefinition Width="12" /><ColumnDefinition Width="320" MinWidth="280" /></Grid.ColumnDefinitions>
            <Border Background="White" CornerRadius="10" BorderBrush="#E1E7F0" BorderThickness="1" Padding="0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Padding="16,12" BorderBrush="#E8EDF4" BorderThickness="0,0,0,1">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="适应窗口" Command="{x:Static local:UiCommands.Fit}" Padding="9,4" MinHeight="28" FontSize="12" ToolTip="适应窗口 · Ctrl+0" />
                                <Button Content="1:1" Command="{x:Static local:UiCommands.ActualSize}" Padding="9,4" MinHeight="28" Margin="0" ToolTip="实际尺寸 · Ctrl+1" />
                            </StackPanel>
                            <TextBlock Text="识别与分拣系统 · 图像工作区" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>
                    <Border DockPanel.Dock="Top" Background="#FBFCFE" Padding="14,10" BorderBrush="#E8EDF4" BorderThickness="0,0,0,1">
                        <WrapPanel>
                            <Button Content="参数分类…" Tag="&#xE713;" Command="{x:Static local:UiCommands.Settings}" ToolTip="打开参数分类入口，按滤波、边缘或轮廓分别设置" Margin="0,0,6,5" />
                            <Button Content="恢复原图" Tag="&#xE777;" Command="{x:Static local:UiCommands.Reset}" ToolTip="恢复原图 · Ctrl+R" Margin="0,0,6,5" />
                            <Button Content="灰度" Tag="&#xE790;" Command="{x:Static local:UiCommands.Grayscale}" ToolTip="查看灰度图；滤波、边缘和产品测量都会自动先转灰度" Margin="0,0,6,5" />
                            <StackPanel Orientation="Horizontal">
                                <Button Content="滤波" Tag="&#xE71C;" Command="{x:Static local:UiCommands.Filter}" ToolTip="图像滤波，类型可在设置中选择" Margin="0,0,0,5" />
                                <Button Content="▾" Width="28" Padding="4,8" Margin="0,0,6,5" Command="{x:Static local:UiCommands.FilterSettings}" ToolTip="滤波参数设置…" AutomationProperties.Name="滤波参数设置" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="边缘" Tag="&#xE7C5;" Command="{x:Static local:UiCommands.Edges}" ToolTip="使用设置中选定的边缘算子与阈值" Margin="0,0,0,5" />
                                <Button Content="▾" Width="28" Padding="4,8" Margin="0,0,6,5" Command="{x:Static local:UiCommands.EdgeSettings}" ToolTip="边缘参数设置…" AutomationProperties.Name="边缘参数设置" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="轮廓" Tag="&#xE7EF;" Command="{x:Static local:UiCommands.Contours}" ToolTip="轮廓提取" Margin="0,0,0,5" />
                                <Button Content="▾" Width="28" Padding="4,8" Margin="0,0,6,5" Command="{x:Static local:UiCommands.ContourSettings}" ToolTip="轮廓参数设置…" AutomationProperties.Name="轮廓参数设置" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="形态学" Tag="&#xE8A7;" Command="{x:Static local:UiCommands.Morphology}" ToolTip="开、闭、腐蚀或膨胀" Margin="0,0,0,5" />
                                <Button Content="▾" Width="28" Padding="4,8" Margin="0,0,6,5" Command="{x:Static local:UiCommands.MorphologySettings}" ToolTip="形态学参数设置…" AutomationProperties.Name="形态学参数设置" />
                            </StackPanel>
                            <Button Content="直方图" Tag="&#xE9D2;" Command="{x:Static local:UiCommands.Histogram}" ToolTip="显示当前结果的灰度分布" Margin="0,0,6,5" />
                            <StackPanel Orientation="Horizontal">
                                <Button Content="模板匹配" Tag="&#xE721;" Command="{x:Static local:UiCommands.Match}" ToolTip="基于模板搜索单个最佳匹配" Margin="0,0,0,5" />
                                <Button Content="▾" Width="28" Padding="4,8" Margin="0,0,6,5" Command="{x:Static local:UiCommands.MatchSettings}" ToolTip="模板匹配参数设置…" AutomationProperties.Name="模板匹配参数设置" />
                            </StackPanel>
                        </WrapPanel>
                    </Border>
                    <Border DockPanel.Dock="Top" Padding="16,10" BorderBrush="#E8EDF4" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="阈值 / 下限" ToolTip="仅灰度阈值轮廓的固定阈值/区间模式使用；Canny、梯度阈值和区间上限请在“轮廓设置”或“边缘设置”中设置" Foreground="#6B7A90" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <Slider x:Name="ThresholdSlider" Grid.Column="1" Minimum="0" Maximum="255" Value="160" SmallChange="1" LargeChange="10" VerticalAlignment="Center" Margin="0,0,12,0" ValueChanged="ThresholdSlider_ValueChanged" />
                            <Grid Grid.Column="2" Margin="0,0,16,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="52" /><ColumnDefinition Width="18" /></Grid.ColumnDefinitions>
                                <TextBox x:Name="ThresholdBox" Text="160" Padding="7,5" LostFocus="ThresholdBox_LostFocus" KeyDown="ThresholdBox_KeyDown" />
                                <StackPanel Grid.Column="1">
                                    <RepeatButton Content="▴" Height="16" Click="ThresholdUp_Click" IsEnabled="{Binding ElementName=ThresholdSlider, Path=IsEnabled}" />
                                    <RepeatButton Content="▾" Height="16" Click="ThresholdDown_Click" IsEnabled="{Binding ElementName=ThresholdSlider, Path=IsEnabled}" />
                                </StackPanel>
                            </Grid>
                            <CheckBox x:Name="InvertCheck" Grid.Column="3" Content="暗色前景" IsChecked="True" VerticalAlignment="Center" Checked="InvertChanged" Unchecked="InvertChanged" ToolTip="白底深色产品开启；深底亮色产品关闭" />
                        </Grid>
                    </Border>
                    <Border DockPanel.Dock="Bottom" Padding="14,8" BorderBrush="#E8EDF4" BorderThickness="0,1,0,0">
                        <TextBox x:Name="PathText" IsReadOnly="True" BorderThickness="0" Background="Transparent" Foreground="#7B889B" FontSize="11" Padding="0" ToolTip="当前图像来源" />
                    </Border>
                    <Border Background="#F7F9FC" Margin="12" CornerRadius="6">
                        <ScrollViewer x:Name="ImageScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled">
                            <Grid>
                                <Image x:Name="PreviewImage" Stretch="Uniform" />
                                <StackPanel x:Name="EmptyHint" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="&#xEB9F;" FontFamily="Segoe MDL2 Assets" FontSize="48" Foreground="#B7C5DA" HorizontalAlignment="Center" Margin="0,0,0,16" />
                                    <TextBlock Text="开始一次图像检测" Foreground="#52647D" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                    <TextBlock Text="打开图片、导入文件夹，或连接摄像头" Foreground="#8A98AB" Margin="0,9,0,0" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>
                    </Border>
                </DockPanel>
            </Border>
            <TabControl Grid.Column="2" Background="White" BorderBrush="#E1E7F0">
                <TabItem Header="产品类">
                    <DockPanel Margin="10">
                        <StackPanel x:Name="ProductEditorPanel" DockPanel.Dock="Top">
                            <TextBlock Text="产品名称" Foreground="#617798" Margin="0,0,0,6" />
                            <TextBox x:Name="ProductNameBox" MaxLength="80" ToolTip="自定义产品名称，最多80个字符" />
                            <DockPanel Margin="0,8,0,8">
                                <Button DockPanel.Dock="Right" Content="目录" Command="{x:Static local:UiCommands.ChooseProductDirectory}" Margin="6,0,0,0" />
                                <TextBox x:Name="ProductDirectoryBox" IsReadOnly="True" ToolTip="产品类保存根目录" />
                            </DockPanel>
                            <TextBlock x:Name="ProductLibraryStatus" Text="0 个产品类" Foreground="#617798" Margin="0,0,0,8" TextWrapping="Wrap" />
                        </StackPanel>
                        <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                            <Button Content="载入样本" Command="{x:Static local:UiCommands.UseProduct}" Padding="8,6" />
                            <Button Content="移出产品库" Command="{x:Static local:UiCommands.RemoveProduct}" Padding="8,6" />
                        </WrapPanel>
                        <DataGrid x:Name="ProductsGrid" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False"
                                  SelectionMode="Single" SelectionChanged="ProductsGrid_SelectionChanged" RowHeight="36"
                                  CanUserResizeColumns="True" HeadersVisibility="Column" EnableRowVirtualization="True"
                                  ScrollViewer.HorizontalScrollBarVisibility="Visible" ScrollViewer.VerticalScrollBarVisibility="Visible"
                                  ScrollViewer.CanContentScroll="True" VirtualizingPanel.ScrollUnit="Pixel">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="产品类型" Binding="{Binding Name}" Width="140" MinWidth="100" />
                                <DataGridTextColumn Header="面积" Binding="{Binding Area, StringFormat=F1}" Width="80" />
                                <DataGridTextColumn Header="周长" Binding="{Binding Perimeter, StringFormat=F1}" Width="80" />
                                <DataGridTextColumn Header="处理算法" Binding="{Binding Algorithms}" Width="SizeToCells" MinWidth="240">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextWrapping" Value="NoWrap" />
                                            <Setter Property="TextTrimming" Value="None" />
                                            <Setter Property="ToolTip" Value="{Binding Algorithms}" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                            <DataGrid.RowStyle><Style TargetType="DataGridRow"><Setter Property="ToolTip" Value="{Binding DirectoryPath}" /></Style></DataGrid.RowStyle>
                        </DataGrid>
                    </DockPanel>
                </TabItem>
                <TabItem Header="图片文件">
            <Border Background="White" BorderBrush="#E1E7F0" BorderThickness="1" CornerRadius="10">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="16,14,16,12">
                        <DockPanel Margin="0,0,0,14">
                            <TextBlock x:Name="FilesSummary" DockPanel.Dock="Right" Text="0 个文件" Foreground="#8A98AB" FontSize="12" VerticalAlignment="Center" />
                            <TextBlock Text="文件资源" FontSize="15" FontWeight="SemiBold" />
                        </DockPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="搜索" Tag="&#xE721;" Command="{x:Static local:UiCommands.Search}" Margin="6,0,0,0" Padding="10,6" />
                            <TextBox x:Name="SearchBox" MinWidth="100" KeyDown="SearchBox_KeyDown" ToolTip="按文件名或路径搜索 · Ctrl+L 聚焦 · 回车搜索" />
                        </DockPanel>
                    </StackPanel>
                    <Border DockPanel.Dock="Bottom" Padding="14,12" BorderBrush="#E8EDF4" BorderThickness="0,1,0,0">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="导出记录" Tag="&#xE898;" Command="{x:Static local:UiCommands.Export}" Margin="6,0,0,0" Padding="10,7" ToolTip="导出 CSV · Ctrl+Shift+E" />
                            <Button Content="检测统计" Tag="&#xE9D2;" Command="{x:Static local:UiCommands.Statistics}" Margin="0" Padding="10,7" />
                        </DockPanel>
                    </Border>
                    <DataGrid x:Name="FilesGrid" Margin="0,0,0,6" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                              SelectionMode="Single" SelectionUnit="FullRow" HeadersVisibility="Column" RowHeight="42" ColumnHeaderHeight="38"
                              Background="White" BorderThickness="0" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F0F3F8"
                              SelectionChanged="FilesGrid_SelectionChanged" LoadingRow="FilesGrid_LoadingRow" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="文件名称" Binding="{Binding Name}" Width="*" MinWidth="105" />
                            <DataGridTextColumn Header="大小" Binding="{Binding SizeText}" Width="85" />
                            <DataGridTextColumn Header="创建时间" Binding="{Binding CreatedText}" Width="150" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

                </TabItem>
                <TabItem Header="运行记录">
                    <DockPanel Margin="8">
                        <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                            <Button Content="导出完整运行日志" Command="{x:Static local:UiCommands.ExportRunLog}" Margin="0,0,0,8" />
                            <TextBlock Text="最近报文（TCP 已写入不等于机器人已执行）" FontSize="11" Foreground="#617798" TextWrapping="Wrap" />
                            <TextBox x:Name="LastRobotMessage" IsReadOnly="True" TextWrapping="Wrap" Height="80" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0" />
                        </StackPanel>
                        <DataGrid x:Name="RunRecordsGrid" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" RowHeight="34">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#" Binding="{Binding Sequence}" Width="45" />
                                <DataGridTextColumn Header="时间" Binding="{Binding Time}" Width="95" />
                                <DataGridTextColumn Header="类型" Binding="{Binding Product}" Width="100" />
                                <DataGridTextColumn Header="面积" Binding="{Binding Area}" Width="85" />
                                <DataGridTextColumn Header="周长" Binding="{Binding Perimeter}" Width="85" />
                                <DataGridTextColumn Header="结果" Binding="{Binding Result}" Width="240" />
                                <DataGridTextColumn Header="发送" Binding="{Binding SendState}" Width="100" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </TabItem>
            </TabControl>
        </Grid>
                </DockPanel>
                <ScrollViewer x:Name="HomePage" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="36,32" MaxWidth="1120" HorizontalAlignment="Stretch">
                        <TextBlock Text="首页" FontSize="14" Foreground="#7B889B" Margin="0,0,0,16" />
                        <TextBlock Text="{x:Static platform:PlatformInfo.Name}" FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="统一管理工业应用模块，按需进入业务工作区。" Foreground="#7B889B" FontSize="14" Margin="0,12,0,26" TextWrapping="Wrap" />
                        <TextBlock Text="应用模块" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,14" />
                        <ItemsControl x:Name="HomeModules" Margin="0,0,0,6">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type platform:ModuleEntry}">
                                    <Border Background="#EAF1FF" CornerRadius="12" Padding="26" Margin="0,0,0,18">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Icon}" FontFamily="Segoe MDL2 Assets" Foreground="#2563EB" FontSize="22" Margin="0,0,12,0" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Name}" FontSize="21" FontWeight="SemiBold" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Description}" Foreground="#617798" Margin="0,12,0,18" TextWrapping="Wrap" />
                                            <WrapPanel>
                                                <Button Content="进入模块" CommandParameter="{Binding Id}" Tag="&#xE768;" Style="{StaticResource PrimaryButton}" Click="ModuleNavigation_Click" Padding="18,11" Margin="0,0,10,8" />
                                                <Button Content="打开产品图片" Tag="&#xE8E5;" Click="OpenFromHome_Click" Padding="18,11" Margin="0,0,0,8"
                                                        Visibility="{Binding CanOpenProductImages, Converter={StaticResource BooleanVisibility}}" />
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Grid Margin="0,0,0,24">
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="18" /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <Border Background="White" CornerRadius="10" BorderBrush="#E1E7F0" BorderThickness="1" Padding="24">
                                <StackPanel>
                                    <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" Foreground="#2563EB" FontSize="26" Margin="0,0,0,16" />
                                    <TextBlock Text="平台设置" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock Text="统一进入设置，配置当前识别与分拣模块的运行参数。" Foreground="#7B889B" TextWrapping="Wrap" Margin="0,10,0,20" />
                                    <Button Content="前往设置" Tag="&#xE72A;" Command="{x:Static local:UiCommands.Settings}" HorizontalAlignment="Left" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Background="White" CornerRadius="10" BorderBrush="#E1E7F0" BorderThickness="1" Padding="24">
                                <StackPanel>
                                    <TextBlock Text="&#xE897;" FontFamily="Segoe MDL2 Assets" Foreground="#2563EB" FontSize="26" Margin="0,0,0,16" />
                                    <TextBlock Text="快速上手" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock Text="了解图片导入、摄像头采样、目标检测和结果导出。" Foreground="#7B889B" TextWrapping="Wrap" Margin="0,10,0,20" />
                                    <Button Content="查看使用说明" Tag="&#xE8A5;" Command="{x:Static local:UiCommands.Help}" HorizontalAlignment="Left" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Border Background="White" CornerRadius="10" Padding="24" BorderBrush="#E1E7F0" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="平台使用流程" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock Text="01  选择应用模块     →     02  配置模块参数     →     03  执行业务操作     →     04  查看与导出结果" Foreground="#7B889B" Margin="0,14,0,0" TextWrapping="Wrap" LineHeight="25" />
                                <TextBlock Text="当前已接入识别与分拣系统；后续应用模块将集中显示在此首页与左侧导航。" Foreground="#8A98AB" Margin="0,12,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
                <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="36,32" MaxWidth="900" HorizontalAlignment="Left">
                        <TextBlock Text="平台设置" FontSize="28" FontWeight="SemiBold" />
                        <TextBlock Text="识别与分拣系统 · 选择一类参数，在独立弹窗中设置。保存生效，取消不应用。" Foreground="#7B889B" TextWrapping="Wrap" Margin="0,12,0,24" />
                        <Border Background="White" CornerRadius="10" Padding="26" BorderBrush="#E1E7F0" BorderThickness="1">
                            <StackPanel Width="600">
                                <TextBlock Text="图像处理参数" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16" />
                                <Button Content="滤波设置…" Tag="&#xE71C;" Command="{x:Static local:UiCommands.FilterSettings}" HorizontalContentAlignment="Left" Margin="0,0,0,10" />
                                <TextBlock Text="滤波类型、平滑核、微分核、高斯与双边 Sigma" Foreground="#7B889B" Margin="0,0,0,18" />
                                <Button Content="边缘检测设置…" Tag="&#xE7C5;" Command="{x:Static local:UiCommands.EdgeSettings}" HorizontalContentAlignment="Left" Margin="0,0,0,10" />
                                <TextBlock Text="Canny 等算子、梯度阈值、边缘闭运算" Foreground="#7B889B" Margin="0,0,0,18" />
                                <Button Content="轮廓提取设置…" Tag="&#xE7EF;" Command="{x:Static local:UiCommands.ContourSettings}" HorizontalContentAlignment="Left" Margin="0,0,0,10" />
                                <TextBlock Text="轮廓来源、灰度分割阈值、前景方向、最小面积" Foreground="#7B889B" Margin="0,0,0,18" />
                                <Button Content="形态学设置…" Tag="&#xE8A7;" Command="{x:Static local:UiCommands.MorphologySettings}" HorizontalContentAlignment="Left" Margin="0,0,0,10" />
                                <Button Content="模板匹配设置…" Tag="&#xE721;" Command="{x:Static local:UiCommands.MatchSettings}" HorizontalContentAlignment="Left" Margin="0,0,0,10" />
                                <TextBlock Text="相机：使用采集菜单的“连接相机”。机器人地址、允许误差及采样频率仍在识别模块中配置。" TextWrapping="Wrap" Foreground="#7B889B" Margin="0,14,0,0" />
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="SettingsSaveStatus" Foreground="#2563EB" Margin="0,16,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
                <ScrollViewer x:Name="AboutPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="36,32" MaxWidth="900" HorizontalAlignment="Left">
                        <TextBlock Text="关于" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,24" />
                        <Border Background="White" CornerRadius="12" Padding="32" BorderBrush="#E1E7F0" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="{x:Static platform:PlatformInfo.Name}" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <Border Background="#EFF6FF" CornerRadius="6" Padding="12,6" HorizontalAlignment="Left" Margin="0,14,0,0">
                                    <TextBlock Text="{x:Static platform:PlatformInfo.VersionLabel}" Foreground="#2563EB" FontSize="14" FontWeight="SemiBold" AutomationProperties.Name="软件版本" />
                                </Border>
                                <TextBlock Text="统一平台入口 · 独立业务模块 · 持续扩展" Foreground="#7B889B" Margin="0,12,0,24" />
                                <TextBlock Text="平台目前接入“识别与分拣系统”模块，支持产品图像采集、检测分析和记录导出。后续业务模块通过统一入口接入。" TextWrapping="Wrap" LineHeight="26" />
                                <Separator Margin="0,22" />
                                <TextBlock Text="当前接入范围" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" />
                                <TextBlock Text="当前识别模块支持产品类建档、自动采样识别和 TCP 产品类型报文。机器人端需按报文协议接收并执行分拣；三维场景与其他业务模块需后续扩展。" Foreground="#7B889B" TextWrapping="Wrap" LineHeight="26" />
                                <Button Content="使用说明" Tag="&#xE8A5;" Command="{x:Static local:UiCommands.Help}" HorizontalAlignment="Left" Margin="0,24,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
